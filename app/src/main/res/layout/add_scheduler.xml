<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".addScheduler">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/scheduler_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin_horizontal"
            android:paddingEnd="@dimen/screen_margin_horizontal"
            android:paddingBottom="@dimen/spacing_lg">

            <TextView
                android:id="@+id/Create_Schedule"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/set_scheduler_options"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:hint="@string/enter_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ed_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Configuration Selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/textView2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/select_configuration"
                    android:textAppearance="?attr/textAppearanceLabelLarge" />

                <com.google.android.material.button.MaterialButton
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/info"
                    android:onClick="scheduler_info"
                    app:icon="@drawable/ic_info_black_24dp"
                    app:iconTint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatSpinner
                android:id="@+id/sp_configs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:minHeight="48dp"
                android:padding="@dimen/spacing_sm" />

            <!-- Time Picker -->
            <TextView
                android:id="@+id/tv_picktime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_header_margin_top"
                android:text="@string/pick_a_time"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary" />

            <TimePicker
                android:id="@+id/timePicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:layout_gravity="center_horizontal"
                android:timePickerMode="spinner" />

            <!-- Repeat Days -->
            <TextView
                android:id="@+id/tv_repeat"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_header_margin_top"
                android:text="@string/repeat"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/toggle_days"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:selectionRequired="false"
                app:singleSelection="false" >

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tb_monday"
                    style="@style/Widget.App.DayToggleButton"
                    android:text="@string/M"
                    android:checkable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tb_tuesday"
                    style="@style/Widget.App.DayToggleButton"
                    android:text="T"
                    android:checkable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tb_wednesday"
                    style="@style/Widget.App.DayToggleButton"
                    android:text="W"
                    android:checkable="true"  />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tb_thursday"
                    style="@style/Widget.App.DayToggleButton"
                    android:text="T"
                    android:checkable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tb_friday"
                    style="@style/Widget.App.DayToggleButton"
                    android:text="F"
                    android:checkable="true"  />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tb_saturday"
                    style="@style/Widget.App.DayToggleButton"
                    android:text="S"
                    android:checkable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tb_sunday"
                    style="@style/Widget.App.DayToggleButton"
                    android:text="S"
                    android:checkable="true"  />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- WiFi Options -->
            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/sw_wifi_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_header_margin_top"
                android:checked="false"
                android:text="Run only when Wi-Fi is connected"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:orientation="horizontal">
            </LinearLayout>

            <!-- Save Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/bt_save_sched"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_header_margin_top"
                android:onClick="saveScheduler"
                android:text="@string/save" />

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
