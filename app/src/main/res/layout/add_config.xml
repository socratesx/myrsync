<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".addConfig">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/config_app_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/config_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="?attr/homeAsUpIndicator" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_margin_horizontal"
            android:paddingEnd="@dimen/screen_margin_horizontal"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- transport type -->
            <TextView
                android:id="@+id/tv_transport_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/transport_type"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <RadioGroup
                android:id="@+id/rg_transport_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:checkedButton="@+id/rb_push"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_daemon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/daemon"
                    android:checked="true"
                    android:layout_marginEnd="@dimen/spacing_lg" />

                <RadioButton
                    android:id="@+id/rb_ssh"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/ssh" />
            </RadioGroup>

            <!-- Server Settings Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/srv_settings"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:hint="@string/configuration_name">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_rsync_alias"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/spacing_sm">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:hint="@string/srv_ip">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ed_srv_ip"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:importantForAutofill="no" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="100dp"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:hint="@string/srv_port">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ed_srv_port"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:importantForAutofill="no" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/lt_rsync_user"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:hint="@string/rsync_user">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ed_rsync_user"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/lt_rsync_srv_mod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="@dimen/spacing_sm">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:hint="@string/srv_mod">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ed_rsync_mod"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:importantForAutofill="no" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ib_info_daemon"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:contentDescription="@string/info"
                    android:onClick="rsync_daemon_info"
                    app:icon="@drawable/ic_info_black_24dp"
                    app:iconTint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Mode -->
            <TextView
                android:id="@+id/tv_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/mode"
                android:textAppearance="?attr/textAppearanceLabelLarge" />

            <RadioGroup
                android:id="@+id/rg_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_xs"
                android:checkedButton="@+id/rb_push"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rb_push"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/push"
                    android:layout_marginEnd="@dimen/spacing_lg" />

                <RadioButton
                    android:id="@+id/rb_pull"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/pull" />
            </RadioGroup>

            <!-- Local Settings Section -->
            <TextView
                android:id="@+id/tv_loc_settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_header_margin_top"
                android:text="@string/loc_settings"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:hint="@string/select_a_path">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ed_path"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:focusable="true"
                        android:textIsSelectable="true" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_add"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="addPath"
                    android:text="@string/add_path" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lt_ssh_options"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:hint="@string/remote_path">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ed_remote_path"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:importantForAutofill="no" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:text="@string/ssh_auth_method"
                    android:textAppearance="?attr/textAppearanceTitleSmall"
                    android:textColor="?attr/colorPrimary" />

                <RadioGroup
                    android:id="@+id/rg_ssh_auth"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rb_ssh_auth_key"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/spacing_md"
                        android:checked="true"
                        android:text="@string/ssh_auth_key" />

                    <RadioButton
                        android:id="@+id/rb_ssh_auth_password"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/ssh_auth_password" />
                </RadioGroup>

                <LinearLayout
                    android:id="@+id/lt_ssh_key_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/spacing_sm"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:hint="@string/ssh_key_path">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/ed_ssh_key_path"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:importantForAutofill="no" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/bt_ssh_path_add"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:onClick="addSshKeyPath"
                        android:text="@string/add_path" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/lt_ssh_password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_md"
                    android:visibility="gone"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:hint="@string/ssh_password"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/ed_ssh_password"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:importantForAutofill="no" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tv_ssh_password_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    android:visibility="gone"
                    android:text="@string/ssh_password_hint"
                    android:textAppearance="?attr/textAppearanceBodySmall" />
            </LinearLayout>

            <!-- Rsync Options Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_header_margin_top"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/opt"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_help_rsync"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/options_help"
                    android:onClick="rsync_help"
                    app:icon="@drawable/baseline_help_24"
                    app:iconTint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:cardCornerRadius="@dimen/card_corner_radius"
                style="?attr/materialCardViewFilledStyle">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_md">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <CheckBox android:id="@+id/cb_a" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="-a" />
                        <CheckBox android:id="@+id/cb_r" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="-r" />
                        <CheckBox android:id="@+id/cb_z" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="-z" />
                        <CheckBox android:id="@+id/cb_v" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="-v" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <CheckBox android:id="@+id/cb_n" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="-n" />
                        <CheckBox android:id="@+id/cb_p" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="-p" />
                        <CheckBox android:id="@+id/cb_t" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="-t" />
                        <CheckBox android:id="@+id/cb_O" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="-O" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <CheckBox android:id="@+id/cb_q" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="-q" />
                        <CheckBox android:id="@+id/cb_m" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="-m" />
                        <CheckBox android:id="@+id/cb_u" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="-u" />
                        <CheckBox android:id="@+id/cb_g" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="-g" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Schedules (optional, multiple per configuration) — Pro feature -->
            <LinearLayout
                android:id="@+id/schedules_section_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_header_margin_top"
                android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/schedules_section"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_add_schedule_slot"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/add_schedule"
                    app:icon="@android:drawable/ic_input_add"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_schedules_pro_locked"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="?attr/colorSurfaceVariant"
                android:text="@string/pro_schedules_teaser"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/schedulers_editor_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/spacing_sm" />

            </LinearLayout>

            <!-- Advanced Options -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_header_margin_top"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_advanced"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/advanced"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_advanced_help"
                    style="?attr/materialIconButtonStyle"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/options_help"
                    android:onClick="rsync_adv_opts_help"
                    app:icon="@drawable/baseline_help_24"
                    app:iconTint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:hint="@string/type_rsync_options_manually">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/ed_advanced_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text"
                    android:importantForAutofill="no" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Command Preview & Actions -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/bt_view"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_header_margin_top"
                android:onClick="viewCommand"
                android:text="@string/view_command" />

            <TextView
                android:id="@+id/tv_view_command_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                android:text="@string/view_command_note"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="?android:attr/textColorSecondary" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_sm"
                app:cardCornerRadius="@dimen/spacing_sm"
                style="?attr/materialCardViewFilledStyle">

                <TextView
                    android:id="@+id/tv_rs_cmd_View"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="60dp"
                    android:padding="@dimen/spacing_md"
                    android:textIsSelectable="true"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:fontFamily="monospace" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_md"
                android:gravity="end"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_execute"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:enabled="false"
                    android:text="@string/run_now" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/bt_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="saveConfig"
                    android:text="@string/save" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
