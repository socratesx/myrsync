<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/spacing_sm"
    app:cardCornerRadius="@dimen/card_corner_radius"
    style="?attr/materialCardViewOutlinedStyle">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_schedule_slot_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                tools:text="Schedule 1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bt_remove_schedule_slot"
                style="?attr/materialIconButtonStyle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/delete"
                app:icon="@drawable/baseline_delete_forever_24"
                app:iconTint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_sm"
            android:text="@string/pick_a_time"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <TimePicker
            android:id="@+id/sched_time_picker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:timePickerMode="spinner" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/repeat"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/sched_toggle_days"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            app:selectionRequired="false"
            app:singleSelection="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tb_monday"
                style="@style/Widget.App.DayToggleButton"
                android:text="@string/M"
                android:checkable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tb_tuesday"
                style="@style/Widget.App.DayToggleButton"
                android:text="T"
                android:checkable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tb_wednesday"
                style="@style/Widget.App.DayToggleButton"
                android:text="W"
                android:checkable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tb_thursday"
                style="@style/Widget.App.DayToggleButton"
                android:text="T"
                android:checkable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tb_friday"
                style="@style/Widget.App.DayToggleButton"
                android:text="F"
                android:checkable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tb_saturday"
                style="@style/Widget.App.DayToggleButton"
                android:text="S"
                android:checkable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tb_sunday"
                style="@style/Widget.App.DayToggleButton"
                android:text="S"
                android:checkable="true" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/sched_sw_wifi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_md"
            android:text="Run only when Wi-Fi is connected"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
