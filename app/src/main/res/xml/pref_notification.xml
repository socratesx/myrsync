<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ListPreference
        android:key="theme_mode"
        android:title="Theme"
        android:summary="Follow system default"
        android:entries="@array/theme_entries"
        android:entryValues="@array/theme_values"
        android:defaultValue="follow_system" />

    <SwitchPreferenceCompat
        android:defaultValue="true"
        android:key="notifications"
        android:summary="Enable Notifications When an Rsync Job Starts"
        android:title="@string/notifications" />

    <!-- AndroidX has no RingtonePreference; Settings opens the system picker. -->
    <Preference
        android:dependency="notifications"
        android:key="ringtone"
        android:title="@string/pref_title_ringtone" />

    <SwitchPreferenceCompat
        android:dependency="notifications"
        android:key="vibrate"
        android:title="@string/pref_title_vibrate" />

    <SwitchPreferenceCompat
        android:defaultValue="false"
        android:key="root_access"
        android:title="Root Access" />

    <Preference
        android:key="pro_upgrade"
        android:title="@string/pro_upgrade_pref_title"
        android:summary="@string/pro_status_free" />

    <Preference
        android:key="pro_restore"
        android:title="@string/pro_restore"
        android:summary="" />

    <SwitchPreferenceCompat
        android:key="pro_debug_unlock"
        android:title="@string/pro_debug_unlock"
        android:defaultValue="false" />

    <Preference
        android:key="privacy_policy"
        android:title="@string/privacy_policy"
        android:summary="@string/privacy_policy_summary" />

</PreferenceScreen>
